#include<stdio.h>
int main(){
    int N, digit,count = 0;
    int power = 1, temp;
    int sum = 0,original;
    scanf("%d",&N);
    temp = N;
    original = N;
   do{
      digit = N % 10;
        N = N / 10;
       count++;
   }while(N != 0);
   while(temp != 0){
      digit = temp % 10;
       temp = temp / 10;
      power = 1;
      for(int i = 0; i < count; i ++){
          power = power * digit;  
      }
      sum = sum + power;
   }
    if(sum == original){
        printf("Armstrong");
    }
    else{
        printf("Not Armstrong");
    }
   return 0;
}
